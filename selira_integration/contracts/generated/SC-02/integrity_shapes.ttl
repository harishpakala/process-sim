@prefix selira: <https://example.org/selira/contracts#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

selira:DexpiAssetIntegrity_SC_02 a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "SC_02: exactly one canonical product required" ;
            sh:select """SELECT $this WHERE {
  FILTER (
    NOT EXISTS {
      $this <https://example.org/dexpi/hasAssetIdentifier> ?ref .
      ?product a <https://example.org/assetinventory/Asset> ; <https://example.org/assetinventory/hasAssetIdentifier> ?id .
      FILTER (STR(?ref) = STR(?id))
    }
    ||
    EXISTS {
      $this <https://example.org/dexpi/hasAssetIdentifier> ?ref1 .
      ?p1 a <https://example.org/assetinventory/Asset> ; <https://example.org/assetinventory/hasAssetIdentifier> ?id1 .
      $this <https://example.org/dexpi/hasAssetIdentifier> ?ref2 .
      ?p2 a <https://example.org/assetinventory/Asset> ; <https://example.org/assetinventory/hasAssetIdentifier> ?id2 .
      FILTER (?p1 != ?p2 && STR(?ref1) = STR(?id1) && STR(?ref2) = STR(?id2))
    }
  )
}""" ] ;
    sh:targetSubjectsOf <https://example.org/dexpi/hasAssetIdentifier> .

