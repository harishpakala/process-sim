SELECT $this WHERE {
      $this <https://example.org/ecad/hasLocalId> ?local ; <https://example.org/ecad/hasAssetIdentifier> ?asset .
      FILTER (!(REGEX(STR(?local), "^[A-Za-z0-9_-]+$")
        && REGEX(STR(?asset), "^https?://[^/?#]+/([^?#]*/)?[A-Za-z0-9_-]+$")
        && STRLEN(REPLACE(STR(?local), "[_-]", "")) > 0
        && STRLEN(REPLACE(REPLACE(STR(?asset), "^.*/", ""), "[_-]", "")) > 0
        && (REPLACE(STR(?local), "[_-]", "") = REPLACE(REPLACE(STR(?asset), "^.*/", ""), "[_-]", ""))))
    }
