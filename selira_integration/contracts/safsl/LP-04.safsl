// Per-instance selection of reassessment versus reuse.
// The host evaluates the candidate when Reassess is true.
Specification SelectiveContractRevalidation {
    StartTerminal=[LP_04];
    Process LP_04 {
        Interface {
            Terminal Input START;
            Terminal Output DONE;
            Port Input Affected;
            Port Input CoverageAttested;
            Port Input PolicyUnchanged;
            Port Input AuthorityUnchanged;
            Port Output Reassess;
            Port Output Reuse;
        }
        Body {
            assign(Reassess, or(Affected, not(and(CoverageAttested, PolicyUnchanged, AuthorityUnchanged))));
            assign(Reuse, not(Reassess));
        }
    }
}
