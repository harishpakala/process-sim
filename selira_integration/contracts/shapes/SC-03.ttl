@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix selira: <https://example.org/selira/> .
# Proposed SELiRA evidence vocabulary; not yet mapped to source RDF.
# This shape is only a readiness-gated prototype; not an engineering certification.
selira:SC03 a sh:NodeShape ; sh:targetSubjectsOf selira:unit ;
 sh:sparql [ sh:message "Missing verified unit compatibility evidence." ; sh:select """
 PREFIX selira: <https://example.org/selira/>
 SELECT $this WHERE { $this selira:unit ?value . FILTER NOT EXISTS { $this selira:verifiedCompatibleUnit true . } }
 """ ] .
