@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix selira: <https://example.org/selira/> .
# Proposed SELiRA evidence vocabulary; not yet mapped to source RDF.
# This shape is only a readiness-gated prototype; not an engineering certification.
selira:SC05 a sh:NodeShape ; sh:targetSubjectsOf selira:relationship ;
 sh:sparql [ sh:message "Missing verified cross-representation relationship evidence." ; sh:select """
 PREFIX selira: <https://example.org/selira/>
 SELECT $this WHERE { $this selira:relationship ?value . FILTER NOT EXISTS { $this selira:verifiedRelationship true . } }
 """ ] .
