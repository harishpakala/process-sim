aas:RelationshipElement a owl:Class ;
    rdfs:label "AAS Relationship Element" .

ecad:hasConnections a owl:ObjectProperty ;
    rdfs:label "Connections",
        "hasConnections" ;
    rdfs:comment "Collection of connections between schematic elements."@en .

ecad:hasCrossDomainAssociationEvidence a owl:DatatypeProperty ;
    rdfs:label "CrossDomainAssociationEvidence",
        "hasCrossDomainAssociationEvidence" ;
    rdfs:comment "Evidence recorded for the cross-domain association."@en .

ecad:hasCrossDomainAssociationStatus a owl:DatatypeProperty ;
    rdfs:label "CrossDomainAssociationStatus",
        "hasCrossDomainAssociationStatus" ;
    rdfs:comment "Recorded status of an association to another engineering domain."@en .

ecad:hasDevice a owl:ObjectProperty ;
    rdfs:label "Device",
        "hasDevice" ;
    rdfs:comment "Electrical device represented in the engineering design."@en .

ecad:hasDevices a owl:ObjectProperty ;
    rdfs:label "Devices",
        "hasDevices" ;
    rdfs:comment "Collection of electrical devices represented in the ECAD model."@en .

ecad:hasEngineeringInterpretationNote a owl:DatatypeProperty ;
    rdfs:label "EngineeringInterpretationNote",
        "hasEngineeringInterpretationNote" ;
    rdfs:comment "Engineering interpretation or qualification associated with the element."@en .

ecad:hasEngineeringVerificationEvidence a owl:DatatypeProperty ;
    rdfs:label "EngineeringVerificationEvidence",
        "hasEngineeringVerificationEvidence" ;
    rdfs:comment "Recorded evidence supporting engineering verification."@en .

ecad:hasEngineeringVerificationStatus a owl:DatatypeProperty ;
    rdfs:label "EngineeringVerificationStatus",
        "hasEngineeringVerificationStatus" ;
    rdfs:comment "Recorded status of engineering verification for the device."@en .

ecad:hasProductVerificationEvidence a owl:DatatypeProperty ;
    rdfs:label "ProductVerificationEvidence",
        "hasProductVerificationEvidence" ;
    rdfs:comment "Recorded evidence supporting product verification."@en .

ecad:hasProductVerificationStatus a owl:DatatypeProperty ;
    rdfs:label "ProductVerificationStatus",
        "hasProductVerificationStatus" ;
    rdfs:comment "Recorded status of verification against product information."@en .

ecad:hasRelatedAssetIdentifier a owl:DatatypeProperty ;
    rdfs:label "RelatedAssetIdentifier",
        "hasRelatedAssetIdentifier" ;
    rdfs:comment "Identifier of a related asset; distinct from the identifier of the current element."@en .

ecad:hasSchematics a owl:ObjectProperty ;
    rdfs:label "Schematics",
        "hasSchematics" ;
    rdfs:comment "Collection of electrical schematic information."@en .

ecad:hasSymbol a owl:ObjectProperty ;
    rdfs:label "Symbol",
        "hasSymbol" ;
    rdfs:comment "Graphical or logical symbol representing an electrical design element."@en .

ecad:hasSymbols a owl:ObjectProperty ;
    rdfs:label "Symbols",
        "hasSymbols" ;
    rdfs:comment "Collection of schematic symbols."@en .

ecad:hasisConnectedTo a owl:ObjectProperty ;
    rdfs:label "isConnectedTo" ;
    rdfs:comment "Relationship expressing a connection between two schematic elements."@en .

ecad:hasAssetIdentifier a owl:DatatypeProperty ;
    rdfs:label "AssetIdentifier",
        "hasAssetIdentifier" ;
    rdfs:comment "Identifier associated with the represented asset."@en .

ecad:hasConnectionPoints a owl:ObjectProperty ;
    rdfs:label "ConnectionPoints",
        "hasConnectionPoints" ;
    rdfs:comment "Collection of connection points belonging to an electrical device or symbol."@en .

ecad:hasEndPoint a owl:ObjectProperty ;
    rdfs:label "EndPoint",
        "hasEndPoint" ;
    rdfs:comment "Connection endpoint in the electrical design."@en .

ecad:hasPLCEndPoint a owl:ObjectProperty ;
    rdfs:label "PLCEndPoint",
        "hasPLCEndPoint" ;
    rdfs:comment "Connection endpoint associated with a programmable logic controller."@en .

ecad:hasAddress a owl:DatatypeProperty ;
    rdfs:label "Address",
        "hasAddress" ;
    rdfs:comment "Address assigned to the connection endpoint in the electrical design."@en .

ecad:hasLocalId a owl:DatatypeProperty ;
    rdfs:label "LocalId",
        "hasLocalId" ;
    rdfs:comment "Identifier local to the ECAD source model or containing element."@en .

aas:SMC a owl:Class ;
    rdfs:label "Submodel Element Collection" .

