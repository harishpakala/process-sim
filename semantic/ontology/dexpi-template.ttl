dexpi:hasActuatedVariable a owl:DatatypeProperty ;
    rdfs:label "ActuatedVariable",
        "hasActuatedVariable" ;
    rdfs:comment "Process variable acted upon by the actuating function."@en .

dexpi:hasActuatingFunction a owl:ObjectProperty ;
    rdfs:label "ActuatingFunction",
        "hasActuatingFunction" ;
    rdfs:comment "Function that actuates or manipulates a process variable."@en .

dexpi:hasActuatingFunctions a owl:ObjectProperty ;
    rdfs:label "ActuatingFunctions",
        "hasActuatingFunctions" ;
    rdfs:comment "Collection of process actuation functions."@en .

dexpi:hasEquipment a owl:ObjectProperty ;
    rdfs:label "Equipment",
        "hasEquipment" ;
    rdfs:comment "Process equipment item identified in the DEXPI engineering model."@en .

dexpi:hasEquipments a owl:ObjectProperty ;
    rdfs:label "Equipments",
        "hasEquipments" ;
    rdfs:comment "Collection of process equipment representations."@en .

dexpi:hasInstrumentationFunction a owl:ObjectProperty ;
    rdfs:label "InstrumentationFunction",
        "hasInstrumentationFunction" ;
    rdfs:comment "Function that measures or observes a process variable."@en .

dexpi:hasInstrumentationFunctions a owl:ObjectProperty ;
    rdfs:label "InstrumentationFunctions",
        "hasInstrumentationFunctions" ;
    rdfs:comment "Collection of instrumentation functions."@en .

dexpi:hasMeasuredVariable a owl:DatatypeProperty ;
    rdfs:label "MeasuredVariable",
        "hasMeasuredVariable" ;
    rdfs:comment "Process variable measured by the instrumentation function."@en .

dexpi:hasCrossDomainAssociationEvidence a owl:DatatypeProperty ;
    rdfs:label "CrossDomainAssociationEvidence",
        "hasCrossDomainAssociationEvidence" ;
    rdfs:comment "Recorded evidence supporting a cross-domain association."@en .

dexpi:hasCrossDomainAssociationStatus a owl:DatatypeProperty ;
    rdfs:label "CrossDomainAssociationStatus",
        "hasCrossDomainAssociationStatus" ;
    rdfs:comment "Recorded status of an association with information in another engineering domain."@en .

dexpi:hasEngineeringInterpretationNote a owl:DatatypeProperty ;
    rdfs:label "EngineeringInterpretationNote",
        "hasEngineeringInterpretationNote" ;
    rdfs:comment "Engineering interpretation or qualification of the represented association."@en .

dexpi:hasRelatedAssetIdentifier a owl:DatatypeProperty ;
    rdfs:label "RelatedAssetIdentifier",
        "hasRelatedAssetIdentifier" ;
    rdfs:comment "Identifier of an asset related to this engineering function; not necessarily the function's own identifier."@en .

dexpi:hasAssetIdentifier a owl:DatatypeProperty ;
    rdfs:label "AssetIdentifier",
        "hasAssetIdentifier" ;
    rdfs:comment "Identifier associated with the represented engineering asset."@en .

dexpi:hasLocalId a owl:DatatypeProperty ;
    rdfs:label "LocalId",
        "hasLocalId" ;
    rdfs:comment "Identifier local to the source engineering model."@en .

