opcuaconnectivity:hasAssetIdentifier a owl:DatatypeProperty ;
    rdfs:label "AssetIdentifier",
        "hasAssetIdentifier" ;
    rdfs:comment "Identifier of the asset associated with this signal mapping."@en .

opcuaconnectivity:hasECADConnectionPointReferenceStatus a owl:DatatypeProperty ;
    rdfs:label "ECADConnectionPointReferenceStatus",
        "hasECADConnectionPointReferenceStatus" ;
    rdfs:comment "Status of the reference to an ECAD connection point."@en .

opcuaconnectivity:hasEndpointStatus a owl:DatatypeProperty ;
    rdfs:label "EndpointStatus",
        "hasEndpointStatus" ;
    rdfs:comment "Status of the OPC UA server endpoint."@en .

opcuaconnectivity:hasEndpointUrl a owl:DatatypeProperty ;
    rdfs:label "EndpointUrl",
        "hasEndpointUrl" ;
    rdfs:comment "Network endpoint URL used to connect to the OPC UA server."@en .

opcuaconnectivity:hasEngineeringFunctionReference a owl:DatatypeProperty ;
    rdfs:label "EngineeringFunctionReference",
        "hasEngineeringFunctionReference" ;
    rdfs:comment "Reference linking the signal mapping to an engineering function; not necessarily an engineering function identifier."@en .

opcuaconnectivity:hasEngineeringInterpretationNote a owl:DatatypeProperty ;
    rdfs:label "EngineeringInterpretationNote",
        "hasEngineeringInterpretationNote" ;
    rdfs:comment "Engineering note documenting interpretation or uncertainty about this mapping."@en .

opcuaconnectivity:hasInventoryAssociationEvidence a owl:DatatypeProperty ;
    rdfs:label "InventoryAssociationEvidence",
        "hasInventoryAssociationEvidence" ;
    rdfs:comment "Evidence supporting the inventory asset association."@en .

opcuaconnectivity:hasInventoryAssociationStatus a owl:DatatypeProperty ;
    rdfs:label "InventoryAssociationStatus",
        "hasInventoryAssociationStatus" ;
    rdfs:comment "Status of the association with an inventory asset."@en .

opcuaconnectivity:hasMappingBasis a owl:DatatypeProperty ;
    rdfs:label "MappingBasis",
        "hasMappingBasis" ;
    rdfs:comment "Evidence or method used to establish the signal mapping."@en .

opcuaconnectivity:hasMappingStatus a owl:DatatypeProperty ;
    rdfs:label "MappingStatus",
        "hasMappingStatus" ;
    rdfs:comment "Status of the engineering-to-OPC-UA signal mapping."@en .

opcuaconnectivity:hasNamespaceURI a owl:DatatypeProperty ;
    rdfs:label "NamespaceURI",
        "hasNamespaceURI" ;
    rdfs:comment "Namespace URI identifying an OPC UA namespace."@en .

opcuaconnectivity:hasOPCUABrowsePath a owl:DatatypeProperty ;
