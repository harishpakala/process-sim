<http://org.example.com/aHR0cHM6Ly9leGFtcGxlLm9yZy9zbS9wcm9kdWN0LWNhdGFsb2ctdGVtcGxhdGU/c2hhcGU> a sh:NodeShape ;
    rdfs:label "ProductCatalog SHACL shape" ;
    sh:description "Product catalog submodel containing manufacturer, supplier, classification, and technical product information."@en ;
    sh:name "ProductCatalog" ;
    sh:property <http://org.example.com/aHR0cHM6Ly9leGFtcGxlLm9yZy9zbS9wcm9kdWN0LWNhdGFsb2ctdGVtcGxhdGU/UHJvZHVjdHMvc2hhcGU> ;
    sh:targetClass <http://org.example.com/aHR0cHM6Ly9leGFtcGxlLm9yZy9zbS9wcm9kdWN0LWNhdGFsb2ctdGVtcGxhdGU/> .

<http://org.example.com/aHR0cHM6Ly9leGFtcGxlLm9yZy9zbS9wcm9kdWN0LWNhdGFsb2ctdGVtcGxhdGU/> a owl:Class ;
    rdfs:label "ProductCatalog" ;
    rdfs:comment "Product catalog submodel containing manufacturer, supplier, classification, and technical product information."@en .

<http://org.example.com/aHR0cHM6Ly9leGFtcGxlLm9yZy9zbS9wcm9kdWN0LWNhdGFsb2ctdGVtcGxhdGU/UHJvZHVjdHMuUHJvZHVjdC5FQ0xBU1NDbGFzcy9zaGFwZQ> a sh:PropertyShape ;
    rdfs:label "ECLASSClass constraint" ;
    sh:datatype xsd:string ;
    sh:description "ECLASS classification associated with the product."@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "ECLASSClass" ;
    sh:path productcatalog:hasECLASSClass .

<http://org.example.com/aHR0cHM6Ly9leGFtcGxlLm9yZy9zbS9wcm9kdWN0LWNhdGFsb2ctdGVtcGxhdGU/UHJvZHVjdHMuUHJvZHVjdC5FQ0xBU1NJUkRJL3NoYXBl> a sh:PropertyShape ;
