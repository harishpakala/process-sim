productcatalog:hasECLASSClass a owl:DatatypeProperty ;
    rdfs:label "ECLASSClass",
        "hasECLASSClass" ;
    rdfs:comment "ECLASS classification associated with the product."@en .

productcatalog:hasECLASSIRDI a owl:DatatypeProperty ;
    rdfs:label "ECLASSIRDI",
        "hasECLASSIRDI" ;
    rdfs:comment "International Registration Data Identifier for the ECLASS classification."@en .

productcatalog:hasECLASSPreferredName a owl:DatatypeProperty ;
    rdfs:label "ECLASSPreferredName",
        "hasECLASSPreferredName" ;
    rdfs:comment "Preferred name of the assigned ECLASS classification."@en .

productcatalog:hasManufacturerName a owl:DatatypeProperty ;
    rdfs:label "ManufacturerName",
        "hasManufacturerName" ;
    rdfs:comment "Name of the product manufacturer."@en .

productcatalog:hasManufacturerPartNumber a owl:DatatypeProperty ;
    rdfs:label "ManufacturerPartNumber",
        "hasManufacturerPartNumber" ;
    rdfs:comment "Part number assigned by the product manufacturer."@en .

productcatalog:hasManufacturerProductDesignation a owl:DatatypeProperty ;
    rdfs:label "ManufacturerProductDesignation",
        "hasManufacturerProductDesignation" ;
    rdfs:comment "Product designation assigned by the manufacturer."@en .

productcatalog:hasProduct a owl:ObjectProperty ;
    rdfs:label "Product",
        "hasProduct" ;
    rdfs:comment "Catalog record describing an identified product."@en .

productcatalog:hasProductDescription a owl:DatatypeProperty ;
    rdfs:label "ProductDescription",
        "hasProductDescription" ;
    rdfs:comment "Textual description of the catalog product."@en .

productcatalog:hasProductIdentifier a owl:DatatypeProperty ;
    rdfs:label "ProductIdentifier",
        "hasProductIdentifier" ;
    rdfs:comment "Identifier of the catalog product; distinct from an installed asset identifier."@en .

productcatalog:hasProducts a owl:ObjectProperty ;
    rdfs:label "Products",
        "hasProducts" ;
    rdfs:comment "Collection of catalog product records."@en .

productcatalog:hasSupplierName a owl:DatatypeProperty ;
    rdfs:label "SupplierName",
        "hasSupplierName" ;
    rdfs:comment "Name of the product supplier."@en .

productcatalog:hasSupplierPartNumber a owl:DatatypeProperty ;
    rdfs:label "SupplierPartNumber",
        "hasSupplierPartNumber" ;
    rdfs:comment "Part number assigned by the supplier."@en .

productcatalog:hasTechnicalProperties a owl:ObjectProperty ;
    rdfs:label "TechnicalProperties",
        "hasTechnicalProperties" ;
    rdfs:comment "Collection of technical properties associated with the product."@en .

productcatalog:hasTechnicalProperty a owl:ObjectProperty ;
    rdfs:label "TechnicalProperty",
        "hasTechnicalProperty" ;
    rdfs:comment "Technical characteristic recorded for the catalog product."@en .

aas:SMC a owl:Class ;
    rdfs:label "Submodel Element Collection" .

