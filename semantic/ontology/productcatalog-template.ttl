    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "ECLASSIRDI" ;
    sh:path productcatalog:hasECLASSIRDI .

<http://org.example.com/aHR0cHM6Ly9leGFtcGxlLm9yZy9zbS9wcm9kdWN0LWNhdGFsb2ctdGVtcGxhdGU/UHJvZHVjdHMuUHJvZHVjdC5FQ0xBU1NQcmVmZXJyZWROYW1lL3NoYXBl> a sh:PropertyShape ;
