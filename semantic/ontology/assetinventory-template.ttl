assetinventory:hasAsset a owl:ObjectProperty ;
    rdfs:label "Asset",
        "hasAsset" ;
    rdfs:comment "Inventory record for an identified asset."@en .

assetinventory:hasAssetIdentifier a owl:DatatypeProperty ;
    rdfs:label "AssetIdentifier",
        "hasAssetIdentifier" ;
    rdfs:comment "Identifier of the asset represented by this inventory record."@en .

assetinventory:hasAssetName a owl:DatatypeProperty ;
    rdfs:label "AssetName",
        "hasAssetName" ;
    rdfs:comment "Human-readable name of the asset."@en .

assetinventory:hasAssetType a owl:DatatypeProperty ;
    rdfs:label "AssetType",
        "hasAssetType" ;
    rdfs:comment "Recorded type or category of the asset."@en .

assetinventory:hasAssets a owl:ObjectProperty ;
    rdfs:label "Assets",
        "hasAssets" ;
    rdfs:comment "Collection of inventory asset records."@en .

assetinventory:hasCrossDomainAssociationEvidence a owl:DatatypeProperty ;
    rdfs:label "CrossDomainAssociationEvidence",
        "hasCrossDomainAssociationEvidence" ;
    rdfs:comment "Evidence recorded for a cross-domain association."@en .

assetinventory:hasCrossDomainAssociationStatus a owl:DatatypeProperty ;
    rdfs:label "CrossDomainAssociationStatus",
        "hasCrossDomainAssociationStatus" ;
    rdfs:comment "Recorded status of an association to information in another domain."@en .

assetinventory:hasEngineeringInterpretationNote a owl:DatatypeProperty ;
    rdfs:label "EngineeringInterpretationNote",
        "hasEngineeringInterpretationNote" ;
    rdfs:comment "Engineering interpretation or qualification recorded for the asset."@en .

assetinventory:hasEquipmentTag a owl:DatatypeProperty ;
    rdfs:label "EquipmentTag",
        "hasEquipmentTag" ;
    rdfs:comment "Equipment tag assigned to the asset in engineering or plant documentation."@en .

assetinventory:hasFaultDetectionStatus a owl:DatatypeProperty ;
    rdfs:label "FaultDetectionStatus",
        "hasFaultDetectionStatus" ;
    rdfs:comment "Recorded status of fault detection activities for the asset."@en .

assetinventory:hasFaultInjectionStatus a owl:DatatypeProperty ;
    rdfs:label "FaultInjectionStatus",
        "hasFaultInjectionStatus" ;
    rdfs:comment "Recorded status of fault injection activities for the asset."@en .

assetinventory:hasLocation a owl:DatatypeProperty ;
    rdfs:label "Location",
        "hasLocation" ;
    rdfs:comment "Recorded location of the asset."@en .

assetinventory:hasModelingStatus a owl:DatatypeProperty ;
    rdfs:label "ModelingStatus",
        "hasModelingStatus" ;
    rdfs:comment "Recorded status of modeling activities for the asset."@en .

assetinventory:hasMonitoringStatus a owl:DatatypeProperty ;
    rdfs:label "MonitoringStatus",
        "hasMonitoringStatus" ;
    rdfs:comment "Recorded status of monitoring activities for the asset."@en .

assetinventory:hasProductIdentifier a owl:DatatypeProperty ;
    rdfs:label "ProductIdentifier",
        "hasProductIdentifier" ;
    rdfs:comment "Identifier of the product associated with the asset; distinct from the asset identifier."@en .

assetinventory:hasRelatedAssetIdentifier a owl:DatatypeProperty ;
    rdfs:label "RelatedAssetIdentifier",
        "hasRelatedAssetIdentifier" ;
    rdfs:comment "Identifier of an asset related to the inventory asset."@en .

assetinventory:hasSimulationStatus a owl:DatatypeProperty ;
    rdfs:label "SimulationStatus",
        "hasSimulationStatus" ;
    rdfs:comment "Recorded status of simulation activities for the asset."@en .

aas:SMC a owl:Class ;
    rdfs:label "Submodel Element Collection" .

