engineeringbom:hasAssemblies a owl:ObjectProperty ;
    rdfs:label "Assemblies",
        "hasAssemblies" ;
    rdfs:comment "Collection of source-recorded engineering assembly entries in the bill-of-materials structure."@en .

engineeringbom:hasAssemblyRecord a owl:ObjectProperty ;
    rdfs:label "AssemblyRecord",
        "hasAssemblyRecord" ;
    rdfs:comment "Engineering assembly record with item identification, descriptive information, revision, structural status, and recorded parent relationship."@en .

engineeringbom:hasAssetIdentifier a owl:DatatypeProperty ;
    rdfs:label "AssetIdentifier",
        "hasAssetIdentifier" ;
    rdfs:comment "Asset identifier recorded against the BOM item; does not establish identity with an AssetInventory record."@en .

engineeringbom:hasBOMItemRecord a owl:ObjectProperty ;
    rdfs:label "BOMItemRecord",
        "hasBOMItemRecord" ;
    rdfs:comment "Source-recorded engineering BOM item or component with identification, descriptive metadata, provenance, and structural associations."@en .

engineeringbom:hasBOMItems a owl:ObjectProperty ;
    rdfs:label "BOMItems",
        "hasBOMItems" ;
    rdfs:comment "Collection of engineering bill-of-materials item records with identifiers, provenance, and recorded associations."@en .

engineeringbom:hasEngineeringLocalId a owl:DatatypeProperty ;
    rdfs:label "EngineeringLocalId",
        "hasEngineeringLocalId" ;
    rdfs:comment "Local identifier assigned by the source engineering system to this BOM item."@en .

engineeringbom:hasFunctionalAssociation a owl:ObjectProperty ;
    rdfs:label "FunctionalAssociation",
        "hasFunctionalAssociation" ;
    rdfs:comment "Source-recorded functional association with provenance and association basis; not an assertion of entity equivalence."@en .

engineeringbom:hasFunctionalAssociations a owl:ObjectProperty ;
    rdfs:label "FunctionalAssociations",
        "hasFunctionalAssociations" ;
    rdfs:comment "Collection of source-recorded functional associations between engineering records."@en .

engineeringbom:hasParentReference a owl:ObjectProperty ;
    rdfs:label "ParentReference",
        "hasParentReference" ;
    rdfs:comment "Source-derived parent-reference record with provenance, structural status, and explicit relationship information."@en .

engineeringbom:hasParentReferences a owl:ObjectProperty ;
    rdfs:label "ParentReferences",
        "hasParentReferences" ;
    rdfs:comment "Collection of source-derived records documenting parent references in the engineering BOM."@en .

engineeringbom:hasProductIdentifier a owl:DatatypeProperty ;
    rdfs:label "ProductIdentifier",
        "hasProductIdentifier" ;
    rdfs:comment "Product identifier recorded against the BOM item; catalog correspondence requires independent evidence."@en .

engineeringbom:hasQuantityBasis a owl:DatatypeProperty ;
    rdfs:label "QuantityBasis",
        "hasQuantityBasis" ;
    rdfs:comment "Basis for interpreting source quantity information; not itself a quantity value."@en .

engineeringbom:hasSourceDomain a owl:DatatypeProperty ;
    rdfs:label "SourceDomain",
        "hasSourceDomain" ;
    rdfs:comment "Domain or system from which the BOM item record originates."@en .

engineeringbom:hasSourceGroup a owl:DatatypeProperty ;
    rdfs:label "SourceGroup",
        "hasSourceGroup" ;
    rdfs:comment "Source grouping or category assigned to the BOM item."@en .

engineeringbom:hasfunctionallyAssociatedWith a owl:ObjectProperty ;
    rdfs:label "functionallyAssociatedWith" ;
    rdfs:comment "Explicitly recorded functional relationship between referenced engineering elements, without asserting identity or verified cross-domain mapping."@en .

engineeringbom:hasAssociationBasis a owl:DatatypeProperty ;
    rdfs:label "AssociationBasis",
        "hasAssociationBasis" ;
    rdfs:comment "Source-provided basis or evidence category for a recorded item association."@en,
        "Source-provided basis or evidence category for this functional association."@en .

engineeringbom:hasBOMItemId a owl:DatatypeProperty ;
    rdfs:label "BOMItemId",
        "hasBOMItemId" ;
    rdfs:comment "Identifier of this item in the engineering BOM source; not necessarily a globally unique asset or product identifier."@en,
        "Source identifier of the engineering BOM item represented by this assembly record."@en .

engineeringbom:hasItemDescription a owl:DatatypeProperty ;
    rdfs:label "ItemDescription",
        "hasItemDescription" ;
    rdfs:comment "Source-provided description of the engineering BOM item or component."@en,
        "Source-provided description of the engineering item represented by the assembly."@en .

engineeringbom:hasLabel a owl:DatatypeProperty ;
    rdfs:label "Label",
        "hasLabel" ;
    rdfs:comment "Human-readable label for the assembly record."@en,
        "Human-readable label of the engineering BOM item."@en .

engineeringbom:hasRevision a owl:DatatypeProperty ;
    rdfs:label "Revision",
        "hasRevision" ;
    rdfs:comment "Source-recorded revision designation for the assembly entry."@en,
        "Source-recorded revision designation of the BOM item."@en .

engineeringbom:hasSourceField a owl:DatatypeProperty ;
    rdfs:label "SourceField",
        "hasSourceField" ;
    rdfs:comment "Name of the source field supplying the functional association."@en,
        "Name of the source field supplying this parent reference."@en .

engineeringbom:hasSourceRecordId a owl:DatatypeProperty ;
    rdfs:label "SourceRecordId",
        "hasSourceRecordId" ;
    rdfs:comment "Identifier of the source record supporting this functional association."@en,
        "Identifier of the source record supporting this parent reference."@en .

engineeringbom:hasRecordedParent a owl:ObjectProperty ;
    rdfs:label "RecordedParent" ;
    rdfs:comment "Explicit parent relationship preserved from the source parent-reference record."@en,
        "Explicit parent relationship recorded for this assembly entry; not an inferred hierarchy."@en,
        "Explicit source-recorded parent relationship of the BOM item, not an inferred or cross-domain join."@en .

aas:RelationshipElement a owl:Class ;
    rdfs:label "AAS Relationship Element" .

engineeringbom:hasStructureStatus a owl:DatatypeProperty ;
    rdfs:label "StructureStatus",
        "hasStructureStatus" ;
    rdfs:comment "Source-recorded status of the BOM item within the engineering structure."@en,
        "Source-recorded status of the functional association."@en,
        "Source-recorded structural status of the assembly entry; interpretation depends on the source vocabulary."@en,
        "Source-recorded structural status of the parent reference."@en .

aas:SMC a owl:Class ;
    rdfs:label "Submodel Element Collection" .

