    rdfs:label "hasEquipmentTag" .

assetinventory:hasFaultDetectionStatus a owl:DatatypeProperty ;
    rdfs:label "hasFaultDetectionStatus" .

assetinventory:hasFaultInjectionStatus a owl:DatatypeProperty ;
