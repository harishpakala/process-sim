assetinventory:hasAsset a owl:ObjectProperty ;
    rdfs:label "hasAsset" .

assetinventory:hasAssetIdentifier a owl:DatatypeProperty ;
    rdfs:label "hasAssetIdentifier" .

assetinventory:hasAssetName a owl:DatatypeProperty ;
    rdfs:label "hasAssetName" .

assetinventory:hasAssetType a owl:DatatypeProperty ;
    rdfs:label "hasAssetType" .

