PREFIX tep: <https://example.org/tep/kg/vocab/>

# Every linked simulated asset, its product type and optional signal.
SELECT ?asset ?product ?signal WHERE {
  ?asset tep:hasProductType ?product .
  OPTIONAL { ?asset tep:hasOperationalSignal ?signal . }
}
ORDER BY ?asset

