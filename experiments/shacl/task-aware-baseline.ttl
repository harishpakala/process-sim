@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <urn:selira:shacl:> .

# Task-scoped SHACL Core + SPARQL profiles.
# Required checks are SHACL property paths; no forbidden SPARQL VALUES.
ex:CAC01Shape a sh:NodeShape ;
  sh:targetClass ex:CAC01Task ;
  sh:property [ sh:path (ex:cac01Check ex:requirement) ; sh:hasValue "runId" ] ;
  sh:property [ sh:path (ex:cac01Check ex:requirement) ; sh:hasValue "timeInterval" ] ;
  sh:property [ sh:path (ex:cac01Check ex:requirement) ; sh:hasValue "units" ] ;
  sh:property [ sh:path (ex:cac01Check ex:requirement) ; sh:hasValue "provenance" ] ;
  sh:property [ sh:path (ex:cac01Check ex:requirement) ; sh:hasValue "measurementCoverage" ] ;
  sh:sparql [
    sh:message "CAC-01: operational check explicitly violated" ;
    sh:select """
      PREFIX ex: <urn:selira:shacl:>
      SELECT $this WHERE {
        $this ex:cac01Check ?check .
        ?check ex:assertedVerdict "VIOLATED" .
      }
    """
  ] .

ex:CAC02Shape a sh:NodeShape ;
  sh:targetClass ex:CAC02Task ;
  sh:property [ sh:path (ex:cac02Check ex:requirement) ; sh:hasValue "approval" ] ;
  sh:property [ sh:path (ex:cac02Check ex:requirement) ; sh:hasValue "targetProperty" ] ;
  sh:property [ sh:path (ex:cac02Check ex:requirement) ; sh:hasValue "units" ] ;
  sh:property [ sh:path (ex:cac02Check ex:requirement) ; sh:hasValue "configuration" ] ;
  sh:sparql [
    sh:message "CAC-02: restriction check explicitly violated" ;
    sh:select """
      PREFIX ex: <urn:selira:shacl:>
      SELECT $this WHERE {
        $this ex:cac02Check ?check .
        ?check ex:assertedVerdict "VIOLATED" .
      }
    """
  ] .
